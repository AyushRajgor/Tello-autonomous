# Gemini API (required)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (reserved fallback, currently unused)
OPENAI_API_KEY=your_openai_api_key_here

# Dashboard
# Defaults to 127.0.0.1 (this computer only). The dashboard can fly the drone:
# only use 0.0.0.0 (reachable from the LAN) together with DASHBOARD_TOKEN.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# Optional shared secret. When set, /ws and /api/* require ?token=<value>;
# open the dashboard as http://<host>:8080/?token=<value>.
# DASHBOARD_TOKEN=change_me_to_a_long_random_string

# Optional extra browser origins allowed to open the dashboard WebSocket
# (comma-separated). localhost/127.0.0.1 on DASHBOARD_PORT and the Vite dev
# server (port 5173) are always allowed.
# DASHBOARD_ALLOWED_ORIGINS=http://my-laptop.local:8080
